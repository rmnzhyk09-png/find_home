# Токен OpenRouter (https://openrouter.ai/keys) — ключ чата /api/chat.
# Без ключа чат работает через встроенный regex-парсер (без LLM).
OPENROUTER_API_KEY=sk-or-v1-...

# Модель OpenRouter (опционально). Примеры: openai/gpt-4o-mini, deepseek/deepseek-chat,
# google/gemini-2.0-flash-001, anthropic/claude-3-haiku
OPENROUTER_MODEL=openai/gpt-4o-mini

# Код региона для источника Дом.РФ (опционально, уникальный ID региона на дом.рф).
DOMRF_REGION_ID=7
