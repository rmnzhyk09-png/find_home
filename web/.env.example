YANDEX_API_KEY=your-yandex-cloud-api-key
YANDEX_FOLDER_ID=your-yandex-cloud-folder-id

# ПРИМЕЧАНИЕ: эти переменные унаследованы от исходного проекта ai_zastroichik
# (планировались для Yandex SpeechKit / GPT-ассистента на serverless).
# Текущий объединённый web-фронтенд (React, из KvartiraPro) работает БЕЗ них:
# весь поиск/чат/парсинг идёт через собственные serverless-роуты /api/*.
# Удалять пока не стали — Android и бэкап-интеграции могут использовать.
