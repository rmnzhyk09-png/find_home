# Токен OpenRouter (https://openrouter.ai/keys) — ключ чата /api/chat.
# Без ключа чат работает через встроенный regex-парсер (без LLM).
OPENROUTER_API_KEY=sk-or-v1-...

# Модель OpenRouter: бесплатная по умолчанию (NVIDIA Nemotron 3.5 Super, :free).
# Фоллбэки внутри кода: nvidia/nemotron-3-ultra-550b-a55b:free, openrouter/free.
# Указывать МОЖНО ТОЛЬКО бесплатный суффикс «:free» (условие пользователя).
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free

# Код региона для источника Дом.РФ (опционально, уникальный ID региона на дом.рф).
DOMRF_REGION_ID=7
